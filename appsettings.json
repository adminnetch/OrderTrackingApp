{
    "ConnectionStrings": {
        "DefaultConnection": "${DB_CONNECTION}"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ProjectStorage": {
        "RootPath": "/mnt/archivio-progetti"
    },
    "Email": {
        "From": "${EMAIL_FROM}",
        "SmtpServer": "${SMTP_SERVER}",
        "SmtpPort": "${SMTP_PORT}",
        "Username": "${EMAIL_USERNAME}",
        "Password": "${EMAIL_PASSWORD}"
    }
}