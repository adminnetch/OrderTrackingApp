@model OrderTrackingApp.Models.RentalRequest
@using OrderTrackingApp.Models
@{
    ViewData["Title"] = "Nuova richiesta di noleggio";
    var categories = ViewBag.Categories as List<Category> ?? new();
}

<h2 class="mb-4">@ViewData["Title"]</h2>

@if (!ViewContext.ModelState.IsValid)
{
    <div class="alert alert-warning">
        <strong>DEBUG:</strong> Model non valido
        <ul>
            @foreach (var kvp in ViewContext.ModelState)
            {
                foreach (var error in kvp.Value.Errors)
                {
                    <li><code>@kvp.Key</code>: @error.ErrorMessage</li>
                }
            }
        </ul>
    </div>
}
else if (Context.Request.Method == "POST")
{
    <div class="alert alert-success">
        <strong>DEBUG:</strong> Model valido - richiesta ricevuta
    </div>
}

<div class="mb-3">
    <label asp-for="UserVisualName" class="form-label">Utente</label>
    <input asp-for="UserVisualName" class="form-control" readonly />
    <span asp-validation-for="UserVisualName" class="text-danger"></span>
</div>

<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CheckIn" class="form-label">Data Check-in</label>
            <input asp-for="CheckIn" class="form-control" type="date" />
            <span asp-validation-for="CheckIn" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="CheckOut" class="form-label">Data Check-out</label>
            <input asp-for="CheckOut" class="form-control" type="date" />
            <span asp-validation-for="CheckOut" class="text-danger"></span>
        </div>

        <div class="mb-3">
    <label asp-for="CinemaOrderId" class="form-label">Progetto</label>
    <select asp-for="CinemaOrderId" class="form-select" asp-items="ViewBag.CinemaOrders">
        <option value="">-- Seleziona un progetto --</option>
    </select>
    <span asp-validation-for="CinemaOrderId" class="text-danger"></span>
</div>


        <div class="col-md-6 mb-3">
            <label asp-for="Type" class="form-label">Tipologia</label>
            <input asp-for="Type" class="form-control" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="col-md-12 mb-3">
            <label asp-for="Client" class="form-label">Cliente</label>
            <input asp-for="Client" class="form-control" />
            <span asp-validation-for="Client" class="text-danger"></span>
        </div>
    </div>

    <h4 class="mt-4 mb-3">Oggetti da noleggiare</h4>

    @if (categories.Any())
    {
        foreach (var category in categories)
        {
            <div class="mb-3 border rounded p-3">
                <strong>@category.Name</strong>
                <div class="row">
                    @foreach (var item in category.Items)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="form-check">
                                <input type="checkbox"
                                       name="selectedItemIds"
                                       value="@item.Id"
                                       id="item_@item.Id"
                                       class="form-check-input" />
                                <label class="form-check-label" for="item_@item.Id">
                                    @item.Name
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <button type="submit" class="btn btn-success mt-3">Invia richiesta</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Annulla</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
