@model OrderTrackingApp.Models.RentalRequest
@using OrderTrackingApp.Models

@{
    ViewData["Title"] = "Dettagli richiesta noleggio";
}

<h2>@ViewData["Title"] (ID: @Model.Id)</h2>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Utente:</strong> @Model.UserVisualName</p>
        <p><strong>Cliente:</strong> @Model.Client</p>
        <p><strong>Progetto:</strong> @Model.CinemaOrderId</p>
        <p><strong>Tipologia:</strong> @Model.Type</p>
        <p><strong>Periodo:</strong> @Model.CheckIn.ToShortDateString() - @Model.CheckOut.ToShortDateString()</p>
        <p><strong>Stato:</strong>
            <span class="badge bg-@GetBadgeClass(Model.Status)">
                @Model.Status
            </span>
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="alert alert-danger mt-2">
                <strong>Motivo del rifiuto:</strong> @Model.RejectionReason
            </div>
        }
    </div>
</div>

<h4>Oggetti richiesti</h4>
<ul class="list-group mb-4">
    @foreach (var item in Model.RequestItems)
    {
        <li class="list-group-item">@item.RentalItem.Name</li>
    }
</ul>

@if (Model.Status == RentalStatus.Pending)
{
    <form method="post" asp-action="Approve" asp-route-id="@Model.Id" class="d-inline">
        <button type="submit" class="btn btn-success me-2">Approva</button>
    </form>

    <form method="post" asp-action="RejectWithoutReason" asp-route-id="@Model.Id" class="d-inline">
        <button type="submit" class="btn btn-dark me-2">Rifiuta (senza motivo)</button>
    </form>

    <form method="post" asp-action="RejectWithReason" asp-route-id="@Model.Id" class="d-inline">
        <div class="input-group mb-2">
            <input type="text" name="reason" class="form-control" placeholder="Motivo del rifiuto..." required />
            <button type="submit" class="btn btn-danger">Rifiuta (con motivo)</button>
        </div>
    </form>
}

@if (Model.Status == RentalStatus.Approved)
{
    <form method="post" asp-action="ConfirmDelivery" asp-route-id="@Model.Id">
        <button type="submit" class="btn btn-primary">Conferma consegna materiale</button>
    </form>
}

@if (Model.Status == RentalStatus.MaterialDelivered)
{
    <form method="post" asp-action="Close" asp-route-id="@Model.Id" class="mb-2">
        <button type="submit" class="btn btn-secondary">Concludi noleggio</button>
    </form>

    <a asp-action="DamageReports" asp-route-requestId="@Model.Id" class="btn btn-outline-danger">
        Vedi segnalazioni danni
    </a>
}

@if (Model.Status == RentalStatus.Closed || 
    Model.Status == RentalStatus.RejectedWithReason ||
    Model.Status == RentalStatus.RejectedWithoutReason)
{
    <form method="post" asp-action="Archive" asp-route-id="@Model.Id" class="mt-3">
        <button type="submit" class="btn btn-outline-dark">Archivia richiesta</button>
    </form>
}

<a asp-action="Index" class="btn btn-link mt-4">Torna alla lista</a>

@functions {
    string GetBadgeClass(RentalStatus status)
    {
        return status switch
        {
            RentalStatus.Pending => "warning",
            RentalStatus.Approved => "success",
            RentalStatus.MaterialDelivered => "primary",
            RentalStatus.RejectedWithReason => "danger",
            RentalStatus.RejectedWithoutReason => "dark",
            RentalStatus.Closed => "secondary",
            RentalStatus.Archived => "light text-dark",
            _ => "info"
        };
    }
}
