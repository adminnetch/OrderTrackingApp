@model OrderTrackingApp.Models.RentalItem
@using OrderTrackingApp.Models

@{
    ViewData["Title"] = "Modifica oggetto";
    var categories = ViewBag.Categories as List<Category> ?? new();
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nome oggetto</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">Categoria</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">-- Seleziona una categoria --</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">
                    @category.Name
                </option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhotoPath" class="form-label">Percorso immagine (facoltativo)</label>
        <input asp-for="PhotoPath" class="form-control" />
        <span asp-validation-for="PhotoPath" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
        <label asp-for="IsAvailable" class="form-check-label">Disponibile</label>
    </div>

    <button type="submit" class="btn btn-primary">Salva modifiche</button>
    <a asp-action="Index" class="btn btn-secondary">Annulla</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
