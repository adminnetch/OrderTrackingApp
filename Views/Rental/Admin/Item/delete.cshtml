@model OrderTrackingApp.Models.RentalItem
@using OrderTrackingApp.Models

@{
    ViewData["Title"] = "Conferma eliminazione oggetto";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning">
    Sei sicuro di voler eliminare il seguente oggetto?
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p><strong>Categoria:</strong> @Model.Category?.Name</p>
        <p><strong>Disponibile:</strong> @(Model.IsAvailable ? "Sì" : "No")</p>

        @if (!string.IsNullOrEmpty(Model.PhotoPath))
        {
            <p><strong>Immagine:</strong> <a href="@Model.PhotoPath" target="_blank">Visualizza</a></p>
        }
    </div>
</div>

<form asp-action="ConfirmDelete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">✅ Elimina definitivamente</button>
    <a asp-action="Index" class="btn btn-secondary">Annulla</a>
</form>
