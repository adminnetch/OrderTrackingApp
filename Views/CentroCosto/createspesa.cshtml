@model OrderTrackingApp.Models.VoceSpesa

@{
    ViewData["Title"] = "Registra Spesa";
}

<h2>Registra una nuova Spesa</h2>

<div asp-validation-summary="All" class="text-danger"></div>


<form asp-action="CreateSpesa" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="CentroCostoId" />

    <div class="form-group mb-3">
        <label asp-for="Data">Data della spesa</label>
        <input asp-for="Data" class="form-control" type="date" />
        <span asp-validation-for="Data" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Tipo">Tipo di spesa</label>
        <select asp-for="Tipo" class="form-control">
            <option value="Catering">Catering</option>
            <option value="Trasporti">Trasporti</option>
            <option value="Materiali">Materiali</option>
            <option value="Retribuzioni">Retribuzioni</option>
            <option value="Noleggi">Noleggi</option>
            <option value="Permessi">Permessi</option>
            <option value="Altro">Altro</option>
        </select>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Importo">Importo (CHF)</label>
        <input asp-for="Importo" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Importo" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Nota">Nota (opzionale)</label>
        <textarea asp-for="Nota" class="form-control"></textarea>
    </div>

    <div class="form-group mb-3">
        <label>Scontrino / Ricevuta</label>
        <input type="file" name="scontrino" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Salva Spesa</button>
    <a asp-action="Index" asp-route-cinemaOrderId="@ViewBag.CinemaOrderId" class="btn btn-secondary">↩️ Indietro</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
