@{
    ViewData["Title"] = "Accesso Negato";
}

<div class="container mt-5 text-center">
    <h1 class="display-4 text-danger">🚫 Accesso Negato</h1>
    <p class="lead mt-3">Non hai i permessi necessari per accedere a questa pagina.</p>

    @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
    {
        <p class="text">Pagina richiesta: <code>@ViewBag.ReturnUrl</code></p>
    }

    <a href="~/" class="btn btn-primary mt-4">🏠 Torna alla Home</a>
</div>
