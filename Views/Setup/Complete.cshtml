@{
    ViewData["Title"] = "Setup Completato";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4>Setup Completato!</h4>
                </div>
                <div class="card-body text-center">
                    <h3 class="text-success">✓ Configurazione Completata</h3>
                    
                    <p class="mt-4">L'applicazione è stata configurata con successo.</p>
                    
                    <p>Ora puoi accedere con le credenziali del SuperAdmin creato.</p>
                    
                    <form method="post" action="/setup/completepost" class="mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">Vai al Login</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>