@model OrderTrackingApp.Controllers.DatabaseSetupViewModel
@{
    ViewData["Title"] = "Database Setup";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Configurazione Database</h4>
                </div>
                <div class="card-body">
                    <h5>Imposta il database</h5>
                    
                    <form id="databaseForm">
                        <div class="mb-3">
                            <label class="form-label">Provider Database</label>
                            <select class="form-select" id="provider" name="provider">
                                <option value="sqlite" selected>SQLite (locale)</option>
                                <option value="mysql">MySQL / MariaDB</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Percorso Database (per SQLite)</label>
                            <input type="text" class="form-control" id="databasePath" name="databasePath" 
                                   value="data/ordertracking.db" />
                            <small class="text-muted">Percorso relativo o assoluto</small>
                        </div>
                        
                        <div id="mysqlConfig" style="display:none;">
                            <div class="mb-3">
                                <label class="form-label">Host</label>
                                <input type="text" class="form-control" id="host" value="localhost" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Port</label>
                                <input type="text" class="form-control" id="port" value="3306" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Database Name</label>
                                <input type="text" class="form-control" id="databaseName" value="ordertracking" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Username</label>
                                <input type="text" class="form-control" id="username" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" />
                            </div>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">Inizializza Database</button>
                    </form>
                    
                    <div id="result" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var providerSelect = document.getElementById('provider');
    var databaseForm = document.getElementById('databaseForm');
    var resultDiv = document.getElementById('result');
    
    if (!providerSelect || !databaseForm || !resultDiv) {
        console.error('Required DOM elements not found');
        if (resultDiv) {
            resultDiv.innerHTML = '<div class="alert alert-danger">Errore: Elementi della pagina non caricati. Ricarica la pagina.</div>';
        }
        return;
    }
    
    providerSelect.addEventListener('change', function() {
        var mysqlConfig = document.getElementById('mysqlConfig');
        if (mysqlConfig) {
            mysqlConfig.style.display = this.value === 'mysql' ? 'block' : 'none';
        }
    });

    databaseForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        var provider = document.getElementById('provider');
        var databasePathInput = document.getElementById('databasePath');
        
        if (!provider || !databasePathInput) {
            resultDiv.innerHTML = '<div class="alert alert-danger">Errore: Input non trovati. Ricarica la pagina.</div>';
            return;
        }
        
        var providerValue = provider.value;
        var databasePathValue = databasePathInput.value;
        
        if (!providerValue || !databasePathValue) {
            resultDiv.innerHTML = '<div class="alert alert-warning">Inserisci tutti i campi richiesti.</div>';
            return;
        }
        
        var model = {
            provider: providerValue,
            databasePath: databasePathValue
        };
        
        try {
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : '';
            
            var response = await fetch('/setup/databasepost', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(model)
            });
            
            var result = await response.json();
            
            if (result.success) {
                resultDiv.innerHTML = '<div class="alert alert-success">Database inizializzato con successo!</div>';
                if (result.redirectUrl) {
                    window.location.href = result.redirectUrl;
                }
            } else {
                var errorMsg = result.errors && result.errors.length > 0 
                    ? result.errors.join(', ') 
                    : 'Errore sconosciuto';
                resultDiv.innerHTML = '<div class="alert alert-danger">Errore: ' + errorMsg + '</div>';
            }
        } catch (err) {
            resultDiv.innerHTML = '<div class="alert alert-danger">Errore di connessione: ' + err.message + '</div>';
        }
    });
});
</script>