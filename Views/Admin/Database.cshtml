@model OrderTrackingApp.Models.AdminDatabaseViewModel
@{
    ViewData["Title"] = "Stato Database";
}

<div class="container mt-4">
    <h1 class="mb-4 border-bottom pb-3">Database & Connessione</h1>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <div class="row mb-4">
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-gear"></i> Stato Installazione</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm">
                        <tbody>
                            <tr>
                                <td class="text-muted w-50">Installation ID</td>
                                <td><code class="small">@Model.InstallationId</code></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Stato</td>
                                <td><span class="badge bg-@(Model.CurrentState == "Complete" ? "success" : "warning")">@Model.CurrentState</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Data Installazione</td>
                                <td>@Model.InstallationDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Data Completamento</td>
                                <td>@(Model.CompletedDate.HasValue ? Model.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Non completato")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Profilo</td>
                                <td>@Model.InstallationProfile</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-database"></i> Database Attuale</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless table-sm">
                        <tbody>
                            <tr>
                                <td class="text-muted w-50">Provider</td>
                                <td><strong>@Model.DatabaseProvider</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Percorso</td>
                                <td><code class="small text-break">@Model.DatabasePath</code></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Ambiente</td>
                                <td><span class="badge bg-info">@Model.Environment</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Versione</td>
                                <td>@Model.AppVersion</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Stato Connessione</td>
                                <td>
                                    @if (Model.DbConnectionStatus == "OK")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> OK</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Errore</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <form asp-action="TestConnection" method="post" asp-controller="Admin">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-repeat"></i> Test connessione
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Utenti</h5>
                </div>
                <div class="card-body text-center">
                    <h2 class="mb-0">@Model.UserCount</h2>
                    <small class="text-muted">utenti registrati</small>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-shield"></i> Permessi</h5>
                </div>
                <div class="card-body text-center">
                    <h2 class="mb-0">@Model.PermissionCount</h2>
                    <small class="text-muted">permessi definiti</small>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-film"></i> Progetti</h5>
                </div>
                <div class="card-body text-center">
                    <h2 class="mb-0">@Model.ProjectCount</h2>
                    <small class="text-muted">CinemaOrders</small>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card border-warning">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-plug"></i> Modifica Connessione</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle"></i> <strong>Modifica configurazione richiede riavvio dell'applicazione.</strong>
                        Usa questa sezione per testare una nuova configurazione prima di applicarla in appsettings.json.
                    </div>
                    
                    <div class="alert alert-secondary mb-3">
                        <i class="bi bi-clock"></i> <strong>Nota:</strong> La modifica completa della connessione database sarà implementata in fase successiva.
                        Richiederà test di connessione effettivo e riavvio dell'applicazione per applicare le nuove impostazioni.
                    </div>
                    
                    <form asp-action="SaveConnection" method="post" asp-controller="Admin" id="connectionForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="provider" class="form-label">Provider</label>
                                <select class="form-select" id="provider" name="provider">
                                    <option value="SQLite" selected="@(Model.ConfigProvider == "SQLite")">SQLite</option>
                                    <option value="MySql" selected="@(Model.ConfigProvider == "MySql")">MySQL / MariaDB</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label for="databaseName" class="form-label">Nome Database</label>
                                <input type="text" class="form-control" id="databaseName" name="databaseName" 
                                       value="@Model.ConfigDatabaseName" placeholder="mydb.sqlite">
                            </div>
                        </div>
                        
                        <div class="row" id="sqliteConfig">
                            <div class="col-md-12 mb-3">
                                <label for="path" class="form-label">Percorso Database</label>
                                <input type="text" class="form-control" id="path" name="path" 
                                       value="@Model.ConfigPath" placeholder="data/app.db">
                            </div>
                        </div>
                        
                        <div class="row" id="mysqlConfig" style="display:none;">
                            <div class="col-md-6 mb-3">
                                <label for="host" class="form-label">Host</label>
                                <input type="text" class="form-control" id="host" name="host" 
                                       value="@Model.ConfigHost" placeholder="localhost">
                            </div>
                            
                            <div class="col-md-3 mb-3">
                                <label for="port" class="form-label">Porta</label>
                                <input type="number" class="form-control" id="port" name="port" 
                                       value="@(Model.ConfigPort > 0 ? Model.ConfigPort : 3306)" placeholder="3306">
                            </div>
                            
                            <div class="col-md-3 mb-3">
                                <label for="ssl" class="form-label">SSL</label>
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox" id="ssl" name="ssl" 
                                           @(Model.ConfigSsl ? "checked" : "")>
                                    <label class="form-check-label" for="ssl">Abilita SSL</label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" class="form-control" id="username" name="username" 
                                       value="@Model.ConfigUsername" placeholder="root">
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label">Password</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="password" name="password" 
                                           placeholder="Lascia vuoto per mantenere attuale">
                                    <span class="input-group-text" style="cursor:pointer;" onclick="togglePassword()">
                                        <i class="bi bi-eye" id="eyeIcon"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-12">
                                <button type="button" class="btn btn-outline-secondary" onclick="testNewConnection()">
                                    <i class="bi bi-arrow-repeat"></i> Test Nuova Configurazione
                                </button>
                            </div>
                        </div>
                    </form>
                    
                    <hr>
                    
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle"></i> <strong>Stato:</strong> Le modifiche sono in modalità bozza.
                        Per applicare permanentemente, aggiorna appsettings.json manualmente e riavvia l'applicazione.
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-3">
        <a href="/Admin" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Torna alla Dashboard
        </a>
    </div>
</div>

<script>
function togglePassword() {
    var input = document.getElementById('password');
    var icon = document.getElementById('eyeIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('bi-eye');
        icon.classList.add('bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.remove('bi-eye-slash');
        icon.classList.add('bi-eye');
    }
}

document.getElementById('provider').addEventListener('change', function() {
    var sqliteConfig = document.getElementById('sqliteConfig');
    var mysqlConfig = document.getElementById('mysqlConfig');
    if (this.value === 'SQLite') {
        sqliteConfig.style.display = 'block';
        mysqlConfig.style.display = 'none';
    } else {
        sqliteConfig.style.display = 'none';
        mysqlConfig.style.display = 'block';
    }
});

function testNewConnection() {
    var form = document.getElementById('connectionForm');
    var formData = new FormData(form);
    
    fetch('/Admin/TestNewConnection', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Connessione OK: ' + data.message);
        } else {
            alert('Errore: ' + data.message);
        }
    })
    .catch(error => {
        alert('Errore: ' + error.message);
    });
}
</script>