<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>In Costruzione</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .logo {
      max-width: 150px;
      margin-bottom: 20px;
    }
    .card {
      padding: 2rem;
      border: none;
      border-radius: 1rem;
      box-shadow: 0 0 20px rgba(0,0,0,0.05);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card bg-white">
          <img src="/wwwroot/images/logo_nuovo_pj.png" alt="Logo" class="logo mx-auto d-block">
          <h1 class="display-6">Funzionalità in arrivo!</h1>
          <p class="lead">Stiamo lavorando per offrirti questa nuova funzione. Torna presto a trovarci!</p>
          <div class="mt-4">
            <a href="/cinema/dashboard" class="btn btn-primary">Torna alla Home</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
